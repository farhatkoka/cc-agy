[Unit]
Description=OmniRoute AI proxy router (User Gateway)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node %h/.local/lib/node_modules/omniroute/bin/omniroute.mjs serve --no-open
Restart=always
RestartSec=3
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=-%h/.omniroute/.env

[Install]
WantedBy=default.target
